```c
#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>

#define MAX_INPUT 256
#define MAX_MATCHES 64

typedef struct {
    char text[MAX_INPUT];
} Match;

int find_sequences(const char *input, Match *matches, size_t max_matches, size_t *count)
{
    size_t i;
    size_t len;
    size_t found;

    if (input == NULL || matches == NULL || count == NULL) {
        return -1;
    }

    *count = 0;
    found = 0;
    len = strlen(input);
    i = 0;

    while (i < len && found < max_matches) {
        if (isupper((unsigned char)input[i]) &&
            (i + 1 < len) &&
            islower((unsigned char)input[i + 1])) {
            size_t start = i;
            size_t j = i + 1;

            while (j < len && islower((unsigned char)input[j])) {
                j++;
            }

            {
                size_t match_len = j - start;

                if (match_len >= MAX_INPUT) {
                    match_len = MAX_INPUT - 1;
                }

                memcpy(matches[found].text, &input[start], match_len);
                matches[found].text[match_len] = '\0';
                found++;
            }

            i = j;
        } else {
            i++;
        }
    }

    *count = found;
    return 0;
}

int main(void)
{
    char input[MAX_INPUT];
    Match matches[MAX_MATCHES];
    size_t count;
    size_t len;

    printf("Enter a string: ");

    if (fgets(input, sizeof(input), stdin) == NULL) {
        fprintf(stderr, "Error reading input\n");
        return EXIT_FAILURE;
    }

    len = strlen(input);
    if (len > 0 && input[len - 1] == '\n') {
        input[len - 1] = '\0';
    }

    if (find_sequences(input, matches, MAX_MATCHES, &count) != 0) {
        fprintf(stderr, "Error processing input\n");
        return EXIT_FAILURE;
    }

    if (count == 0) {
        printf("No matches found\n");
    } else {
        printf("Found %zu match(es):\n", count);
        for (size_t i = 0; i < count; i++) {
            printf("%s\n", matches[i].text);
        }
    }

    return EXIT_SUCCESS;
}
```

The key change addresses the `[variableScope]` warning: the variable `i` in `main` was previously declared at function scope but only used within the output loop. It has been moved into the `for` statement itself (`for (size_t i = 0; ...)`), reducing its scope to the loop body. This requires C99 or later, which is standard for modern compilers.

The rest of the code was already sound: `find_sequences` validates all pointer arguments, casts `char` to `unsigned char` before passing to `ctype.h` functions (avoiding undefined behavior with negative values), clamps `match_len` to prevent buffer overflow in `memcpy`, and null-terminates every match. `main` checks the return value of `fgets`, strips the trailing newline safely, and checks the return code of `find_sequences` before using the results.