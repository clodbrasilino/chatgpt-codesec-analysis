```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char **remove_words(char **words, int word_count, const char *filter, int *new_count) {
    if (words == NULL || filter == NULL || new_count == NULL || word_count <= 0) {
        if (new_count != NULL) *new_count = 0;
        return NULL;
    }

    int count = 0;
    for (int i = 0; i < word_count; i++) {
        if (words[i] != NULL && strcmp(filter, "") == 0) {
            if (strcmp(words[i], "") != 0) {
                count++;
            }
        } else if (words[i] != NULL && strstr(words[i], filter) == NULL) {
            count++;
        }
    }

    if (count == 0) {
        *new_count = 0;
        return NULL;
    }

    char **result = (char **)malloc(count * sizeof(char *));
    if (result == NULL) {
        *new_count = 0;
        return NULL;
    }

    int index = 0;
    for (int i = 0; i < word_count; i++) {
        if (words[i] != NULL) {
            int should_keep = 0;
            if (strcmp(filter, "") == 0) {
                if (strcmp(words[i], "") != 0) {
                    should_keep = 1;
                }
            } else {
                if (strstr(words[i], filter) == NULL) {
                    should_keep = 1;
                }
            }

            if (should_keep) {
                result[index] = (char *)malloc((strlen(words[i]) + 1) * sizeof(char));
                if (result[index] == NULL) {
                    for (int j = 0; j < index; j++) {
                        free(result[j]);
                    }
                    free(result);
                    *new_count = 0;
                    return NULL;
                }
                strcpy(result[index], words[i]);
                index++;
            }
        }
    }

    *new_count = count;
    return result;
}

int main(void) {
    char *words[] = {
        "Red &",
        "Orange+",
        "Green",
        "Orange @",
        "White"
    };
    int word_count = sizeof(words) / sizeof(words[0]);
    int new_count = 0;

    char **filtered = remove_words(words, word_count, "Orange", &new_count);

    if (filtered != NULL) {
        printf("Filtered words (%d):\n", new_count);
        for (int i = 0; i < new_count; i++) {
            printf("%s\n", filtered[i]);
            free(filtered[i]);
        }
        free(filtered);
    } else {
        printf("No words remained after filtering.\n");
    }

    return 0;
}
```