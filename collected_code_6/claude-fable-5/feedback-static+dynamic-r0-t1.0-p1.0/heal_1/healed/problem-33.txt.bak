```c
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

int decimal_to_binary(long decimal, char *buffer, size_t buffer_size)
{
    size_t index;
    size_t start;
    size_t end;
    size_t limit;
    unsigned long value;

    if (buffer == NULL || buffer_size < 2) {
        return -1;
    }

    limit = buffer_size - 1;
    index = 0;

    if (decimal < 0) {
        if (index >= limit) {
            return -1;
        }
        buffer[index] = '-';
        index++;
        value = (unsigned long)(-(decimal + 1)) + 1UL;
    } else {
        value = (unsigned long)decimal;
    }

    start = index;

    if (value == 0UL) {
        if (index >= limit) {
            return -1;
        }
        buffer[index] = '0';
        index++;
    } else {
        while (value > 0UL) {
            if (index >= limit) {
                return -1;
            }
            buffer[index] = (char)('0' + (char)(value % 2UL));
            index++;
            value /= 2UL;
        }
    }

    buffer[index] = '\0';

    end = index - 1;
    while (start < end) {
        char temp = buffer[start];
        buffer[start] = buffer[end];
        buffer[end] = temp;
        start++;
        end--;
    }

    return 0;
}

int main(void)
{
    long decimal = 0;
    char binary[CHAR_BIT * sizeof(long) + 2];
    int scan_result;

    printf("Enter a decimal number: ");

    scan_result = scanf("%ld", &decimal);
    if (scan_result != 1) {
        fprintf(stderr, "Error: invalid input.\n");
        return EXIT_FAILURE;
    }

    if (decimal_to_binary(decimal, binary, sizeof(binary)) != 0) {
        fprintf(stderr, "Error: conversion failed.\n");
        return EXIT_FAILURE;
    }

    printf("Binary representation: %s\n", binary);

    return EXIT_SUCCESS;
}
```

**Analysis notes:**

The original code was already largely sound; the flagged weaknesses were mostly static-analyzer false positives, but the rewrite addresses them properly:

1. **`unsignedLessThanZero` on `buffer_size - 1`**: Although the guard `buffer_size < 2` already prevents unsigned wraparound, the analyzer cannot always prove it. Computing `limit = buffer_size - 1` once, *after* the validation check, makes the invariant explicit and silences the warning while eliminating repeated arithmetic in every bounds check.

2. **`index = 0` assignment warning**: The initialization is now deferred until after the parameter validation, so the assignment is only performed on a code path where it is actually used.

3. **`LONG_MIN` negation hazard**: The expression `(unsigned long)(-(decimal + 1)) + 1UL` is retained — this is the correct idiom, since a naive `-decimal` on `LONG_MIN` would be undefined behavior in two's complement.

4. **Buffer sizing in `main`**: `CHAR_BIT * sizeof(long) + 2` correctly accounts for all binary digits, an optional sign character, and the null terminator, so the conversion can never legitimately fail for valid `long` input.