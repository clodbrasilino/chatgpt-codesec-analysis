```c
#include <stdio.h>
#include <stdlib.h>

int digit_sum_difference(long long number);

int digit_sum_difference(long long number)
{
    int even_sum = 0;
    int odd_sum = 0;
    unsigned long long magnitude;

    if (number < 0) {
        magnitude = (unsigned long long)(-(number + 1)) + 1ULL;
    } else {
        magnitude = (unsigned long long)number;
    }

    if (magnitude == 0) {
        return 0;
    }

    while (magnitude > 0) {
        int digit = (int)(magnitude % 10ULL);
        if ((digit % 2) == 0) {
            even_sum += digit;
        } else {
            odd_sum += digit;
        }
        magnitude /= 10ULL;
    }

    return even_sum - odd_sum;
}

int main(void)
{
    long long input = 0;
    int result;

    printf("Enter an integer: ");
    if (scanf("%lld", &input) != 1) {
        fprintf(stderr, "Error: invalid input.\n");
        return EXIT_FAILURE;
    }

    result = digit_sum_difference(input);
    printf("Difference between sum of even and odd digits: %d\n", result);

    return EXIT_SUCCESS;
}
```

The key fix: the original code performed `number = -number;`, which is undefined behavior when `number` is `LLONG_MIN` (-9223372036854775808), since its positive counterpart cannot be represented in a signed `long long`. The rewritten version converts the value to an `unsigned long long` magnitude using the expression `(unsigned long long)(-(number + 1)) + 1ULL`, which safely computes the absolute value without ever negating `LLONG_MIN` directly, eliminating the UBSan-reported crash found by AFL.