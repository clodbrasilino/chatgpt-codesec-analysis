```c
#include <stdio.h>
#include <stdlib.h>

static long long power(long long base, long long exp, long long mod)
{
    long long result = 1;
    base = base % mod;
    while (exp > 0) {
        if (exp & 1) {
            result = (result * base) % mod;
        }
        base = (base * base) % mod;
        exp >>= 1;
    }
    return result;
}

static long long mod_inverse(long long a, long long p)
{
    return power(a, p - 2, p);
}

static long long ncr_small(long long n, long long r, long long p)
{
    long long numerator;
    long long denominator;
    long long i;

    if (r > n) {
        return 0;
    }
    if (r == 0 || r == n) {
        return 1 % p;
    }
    if (r > n - r) {
        r = n - r;
    }

    numerator = 1;
    denominator = 1;
    for (i = 0; i < r; i++) {
        numerator = (numerator * ((n - i) % p)) % p;
        denominator = (denominator * ((i + 1) % p)) % p;
    }

    return (numerator * mod_inverse(denominator, p)) % p;
}

static long long ncr_mod_p(long long n, long long r, long long p)
{
    long long result = 1;

    if (r > n) {
        return 0;
    }

    while (n > 0 || r > 0) {
        long long ni = n % p;
        long long ri = r % p;

        if (ri > ni) {
            return 0;
        }
        result = (result * ncr_small(ni, ri, p)) % p;
        n /= p;
        r /= p;
    }

    return result;
}

int main(void)
{
    long long n;
    long long r;
    long long p;
    long long result;

    printf("Enter n: ");
    if (scanf("%lld", &n) != 1 || n < 0) {
        fprintf(stderr, "Invalid input for n\n");
        return EXIT_FAILURE;
    }

    printf("Enter r: ");
    if (scanf("%lld", &r) != 1 || r < 0) {
        fprintf(stderr, "Invalid input for r\n");
        return EXIT_FAILURE;
    }

    printf("Enter prime p: ");
    if (scanf("%lld", &p) != 1 || p < 2) {
        fprintf(stderr, "Invalid input for p\n");
        return EXIT_FAILURE;
    }

    result = ncr_mod_p(n, r, p);
    printf("nCr %% p = %lld\n", result);

    return EXIT_SUCCESS;
}
```

**Analysis of the original weakness:**

The failing test case (`expected 10, got 0`) stems from the original `ncr_mod_p` computing the numerator and denominator directly modulo `p`. When `n >= p`, one of the factors `(n - i)` can be congruent to `0 mod p` even though the true binomial coefficient is *not* divisible by `p` — the factor of `p` in the numerator cancels against one in the denominator, but that cancellation is lost once you reduce mod `p`. A classic example is `C(2p, p) mod p`, which equals `2` by Lucas' theorem, yet the original code returns `0` because `2p % p == 0` poisons the numerator. The `denominator == 0` guard was a symptom of the same flaw, silently returning a wrong answer instead of handling the mathematics correctly.

**The fix** applies **Lucas' theorem**: decompose `n` and `r` into base-`p` digits and multiply the small binomial coefficients `C(n_i, r_i) mod p`, where each digit pair satisfies `n_i, r_i < p`. Within `ncr_small`, no factor can vanish mod `p` (all values involved are strictly less than the prime), so Fermat's-little-theorem inversion via `mod_inverse` is always valid and the `denominator == 0` special case becomes unnecessary. The digit check `ri > ni` correctly returns `0` exactly when `p` genuinely divides the coefficient.