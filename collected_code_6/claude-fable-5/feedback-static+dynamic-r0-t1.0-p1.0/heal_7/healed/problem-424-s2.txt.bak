```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *extract_rear(const char *const *strings, size_t count)
{
    char *result;
    size_t i;

    if (strings == NULL || count == 0U) {
        return NULL;
    }

    result = (char *)malloc(count + 1U);
    if (result == NULL) {
        return NULL;
    }

    for (i = 0U; i < count; i++) {
        size_t len;

        if (strings[i] == NULL) {
            free(result);
            return NULL;
        }

        len = strlen(strings[i]);
        if (len == 0U) {
            result[i] = ' ';
        } else {
            result[i] = strings[i][len - 1U];
        }
    }

    result[count] = '\0';
    return result;
}

int print_rear(const char *rear, size_t count)
{
    size_t i;

    if (rear == NULL) {
        return -1;
    }

    if (fputs("[", stdout) == EOF) {
        return -1;
    }

    for (i = 0U; i < count; i++) {
        if (printf("'%c'", rear[i]) < 0) {
            return -1;
        }
        if (i + 1U < count) {
            if (fputs(", ", stdout) == EOF) {
                return -1;
            }
        }
    }

    if (fputs("]\n", stdout) == EOF) {
        return -1;
    }

    if (fflush(stdout) != 0) {
        return -1;
    }

    return 0;
}

int run_case(const char *const *words, size_t count)
{
    char *rear;
    int status;

    rear = extract_rear(words, count);
    if (rear == NULL) {
        fprintf(stderr, "Failed to extract rear elements\n");
        return -1;
    }

    status = print_rear(rear, count);
    free(rear);

    return status;
}

int main(void)
{
    const char *const words0[] = { "Mers", "for", "Vers" };
    const char *const words1[] = { "blue", "star", "tree" };
    const char *const words2[] = { "pizza", "cat", "hello" };

    if (run_case(words0, sizeof(words0) / sizeof(words0[0])) != 0) {
        return EXIT_FAILURE;
    }

    if (run_case(words1, sizeof(words1) / sizeof(words1[0])) != 0) {
        return EXIT_FAILURE;
    }

    if (run_case(words2, sizeof(words2) / sizeof(words2[0])) != 0) {
        return EXIT_FAILURE;
    }

    return EXIT_SUCCESS;
}
```

**Analysis notes:**

The original logic for extracting the last character of each string was actually sound — `extract_rear` correctly handles `NULL` inputs, empty strings, and allocation failure, and `print_rear` produces exactly the format `['s', 'r', 's']` that the test cases expect.

The "no output" failures reported in the comments are almost always caused by one of these issues rather than the extraction logic itself:

1. **Buffered stdout never flushed before an abnormal exit** — mitigated here by keeping the explicit `fflush(stdout)` after each case.
2. **A build/link failure or early `return`/crash before any printing** — the rewritten version compiles cleanly under `-Wall -Wextra -pedantic` with no undefined behavior, so nothing prevents output from being emitted.
3. **Error paths writing only to `stderr`** — the test harness reads stdout, so if `extract_rear` ever returned `NULL`, the harness would see nothing. The given inputs can never trigger that path, since all arrays are non-empty and contain valid, non-empty strings.

With the given inputs, the program deterministically prints:

```
['s', 'r', 's']
['e', 'r', 'e']
['a', 't', 'o']
```

which matches all three expected test cases. Memory is freed on every path (`free(rear)` after printing, `free(result)` on the `NULL`-element error path), so there are no leaks, and all `stdio` return values are checked for robustness.