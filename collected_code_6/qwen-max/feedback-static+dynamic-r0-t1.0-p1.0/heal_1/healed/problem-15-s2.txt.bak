```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

void split_at_lowercase(const char *input) {
    size_t len = strlen(input);
    const char *start = input;
    for (size_t i = 0; i <= len; ++i) {
        if (i == len || !islower((unsigned char)input[i])) {
            if (i != 0 && islower((unsigned char)input[i - 1])) {
                char *token = (char *)malloc((i - (start - input) + 1) * sizeof(char));
                if (token != NULL) {
                    strncpy(token, start, i - (start - input));
                    token[i - (start - input)] = '\0';
                    printf("%s\n", token);
                    free(token);
                }
            }
            start = input + i;
        }
    }
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        return EXIT_FAILURE;
    }
    split_at_lowercase(argv[1]);
    return EXIT_SUCCESS;
}
```