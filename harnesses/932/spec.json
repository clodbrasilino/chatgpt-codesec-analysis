        "Solution"
      ],
      "assert_src": "assert remove_duplic_list([\"Python\", \"Exercises\", \"Practice\", \"Solution\", \"Exercises\"])==['Python', 'Exercises', 'Practice', 'Solution']"
    },
    {
      "fn_name": "remove_duplic_list",
      "args": [
        [
          "Python",
          "Exercises",
          "Practice",
          "Solution",
          "Exercises",
          "Java"
        ]
      ],
      "expected": [
        "Python",
        "Exercises",
        "Practice",
        "Solution",
        "Java"
      ],
      "assert_src": "assert remove_duplic_list([\"Python\", \"Exercises\", \"Practice\", \"Solution\", \"Exercises\",\"Java\"])==['Python', 'Exercises', 'Practice', 'Solution', 'Java']"
    },
    {
      "fn_name": "remove_duplic_list",
      "args": [
        [
          "Python",
          "Exercises",
          "Practice",
          "Solution",
          "Exercises",
          "C++",
          "C",
