```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <regex.h>

void insert_spaces(char *str) {
    regex_t regex;
    regmatch_t match[1];
    char pattern[] = "([A-Z][^A-Z]*)";

    if (regcomp(&regex, pattern, REG_EXTENDED) != 0) {
        fprintf(stderr, "Could not compile regex\n");
        exit(1);
    }

    int len = strlen(str);
    char *new_str = malloc(len * 2 + 1);
    if (!new_str) {
        fprintf(stderr, "Memory allocation failed\n");
        exit(1);
    }

    strcpy(new_str, str);

    char *pos = new_str;
    while (regexec(&regex, pos, 1, match, 0) == 0) {
        size_t match_len = match[0].rm_eo - match[0].rm_so;
        memmove(pos + match[0].rm_so + 1, pos + match[0].rm_so, match_len + 1);
        pos[match[0].rm_so] = ' ';
        pos += match[0].rm_so + 1;
    }

    strcpy(str, new_str);
    free(new_str);
    regfree(&regex);
}

int main() {
    char input[] = "HelloWorldThisIsATest";
    insert_spaces(input);
    printf("%s\n", input);
    return 0;
}
```