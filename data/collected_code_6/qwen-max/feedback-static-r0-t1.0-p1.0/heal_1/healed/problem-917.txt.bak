```c
#include <stdio.h>
#include <ctype.h>
#include <string.h>

void find_sequences(const char *str) {
    int len = strlen(str);
    for (int i = 0; i < len; ) {
        if (isupper(str[i])) {
            int start = i;
            i++;
            while (i < len && islower(str[i])) {
                i++;
            }
            if (i > start + 1) {
                printf("%.*s\n", i - start, &str[start]);
            } else {
                i = start + 1;
            }
        } else {
            i++;
        }
    }
}

int main() {
    const char *input = "ThisIsAnExample AbCdef Another ExampleA";
    find_sequences(input);
    return 0;
}
```