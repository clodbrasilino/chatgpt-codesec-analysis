```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

long long count_substrings(const char *str)
{
    size_t len;
    long long result;
    long long *freq;
    long long prefix;
    size_t i;
    size_t range;
    size_t offset;

    if (str == NULL) {
        return -1;
    }

    len = strlen(str);
    if (len == 0) {
        return 0;
    }

    for (i = 0; i < len; i++) {
        if (!isdigit((unsigned char)str[i])) {
            return -1;
        }
    }

    range = 10 * len + 1;
    offset = len;

    freq = calloc(range, sizeof(long long));
    if (freq == NULL) {
        return -1;
    }

    prefix = 0;
    result = 0;
    freq[offset] = 1;

    for (i = 0; i < len; i++) {
        prefix += (long long)(str[i] - '0') - 1;
        result += freq[(size_t)(prefix + (long long)offset)];
        freq[(size_t)(prefix + (long long)offset)] += 1;
    }

    free(freq);
    return result;
}

int main(void)
{
    const char *tests[] = { "112112", "111", "1101112", "0102" };
    size_t i;
    size_t n;

    n = sizeof(tests) / sizeof(tests[0]);

    for (i = 0; i < n; i++) {
        long long count = count_substrings(tests[i]);
        if (count < 0) {
            fprintf(stderr, "Error processing string: %s\n", tests[i]);
            return EXIT_FAILURE;
        }
        printf("String: %s -> Count: %lld\n", tests[i], count);
    }

    return EXIT_SUCCESS;
}
```

The only weakness flagged was `[variableScope]` on `count`, which has been fixed by moving its declaration inside the `for` loop body, limiting its scope to the single iteration where it is used. The rest of the code was already sound: input validation covers `NULL` and non-digit characters, `calloc` failure is checked, the buffer is freed on the only path past allocation, index arithmetic is safely bounded since `prefix` ranges within `[-len, 9*len]`, and `isdigit` receives an `unsigned char` cast to avoid undefined behavior on negative `char` values.