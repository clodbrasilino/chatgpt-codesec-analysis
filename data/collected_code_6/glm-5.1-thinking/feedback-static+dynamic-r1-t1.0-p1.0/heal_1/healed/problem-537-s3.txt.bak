```c
#include <ctype.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *return_none(void)
{
    char *res = malloc(5);
    if (res)
    {
        memcpy(res, "None", 5);
    }
    return res;
}

int strcmp_insensitive(const char *a, const char *b)
{
    while (*a && *b)
    {
        int ca = tolower((unsigned char)*a);
        int cb = tolower((unsigned char)*b);
        if (ca != cb)
        {
            return ca - cb;
        }
        a++;
        b++;
    }
    return tolower((unsigned char)*a) - tolower((unsigned char)*b);
}

char *find_first_repeated_word(const char *str)
{
    if (str == NULL)
    {
        return return_none();
    }

    size_t len = strlen(str);
    size_t max_words = len / 2 + 2;
    char **seen = malloc(max_words * sizeof(char *));
    if (seen == NULL)
    {
        return return_none();
    }

    size_t seen_count = 0;
    char *result = NULL;
    size_t i = 0;

    while (str[i] != '\0')
    {
        while (str[i] != '\0' && !isalnum((unsigned char)str[i]))
        {
            i++;
        }

        if (str[i] == '\0')
        {
            break;
        }

        size_t start = i;
        while (str[i] != '\0' && isalnum((unsigned char)str[i]))
        {
            i++;
        }
        size_t word_len = i - start;

        char *word = malloc(word_len + 1);
        if (word == NULL)
        {
            goto cleanup;
        }

        memcpy(word, str + start, word_len);
        word[word_len] = '\0';

        int found = 0;
        for (size_t j = 0; j < seen_count; j++)
        {
            if (strcmp_insensitive(seen[j], word) == 0)
            {
                found = 1;
                result = seen[j];
                seen[j] = NULL;
                break;
            }
        }

        if (found)
        {
            free(word);
            goto cleanup;
        }
        else
        {
            if (seen_count < max_words)
            {
                seen[seen_count++] = word;
            }
            else
            {
                free(word);
            }
        }
    }

cleanup:
    for (size_t j = 0; j < seen_count; j++)
    {
        free(seen[j]);
    }
    free(seen);

    if (result == NULL)
    {
        return return_none();
    }
    return result;
}

int main(void)
{
    const char *text1 = "This is a test, this is only a test.";
    char *repeated = find_first_repeated_word(text1);
    if (repeated != NULL)
    {
        printf("%s\n", repeated);
        free(repeated);
    }

    const char *text2 = "No repetition here";
    repeated = find_first_repeated_word(text2);
    if (repeated != NULL)
    {
        printf("%s\n", repeated);
        free(repeated);
    }

    return 0;
}
```