```c
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

static int mul_ll(long long a, long long b, long long *res)
{
    if (a == 0 || b == 0) {
        *res = 0;
        return 0;
    }
    if (a > 0 && b > 0 && a > LLONG_MAX / b) {
        return -1;
    }
    if (a > 0 && b < 0 && b < LLONG_MIN / a) {
        return -1;
    }
    if (a < 0 && b > 0 && a < LLONG_MIN / b) {
        return -1;
    }
    if (a < 0 && b < 0 && a < LLONG_MAX / b) {
        return -1;
    }
    *res = a * b;
    return 0;
}

static int add_ll(long long a, long long b, long long *res)
{
    if (b > 0 && a > LLONG_MAX - b) {
        return -1;
    }
    if (b < 0 && a < LLONG_MIN - b) {
        return -1;
    }
    *res = a + b;
    return 0;
}

static int count_ways(int n, int k, long long *out)
{
    long long same;
    long long diff;
    long long total;
    int i;

    if (n <= 0 || k <= 0) {
        return -1;
    }

    if (n == 1) {
        *out = (long long)k;
        return 0;
    }

    same = (long long)k;
    if (mul_ll((long long)k, (long long)(k - 1), &diff) != 0) {
        return -1;
    }
    if (add_ll(same, diff, &total) != 0) {
        return -1;
    }

    for (i = 3; i <= n; i++) {
        long long prev_total = total;
        same = diff;
        if (mul_ll(prev_total, (long long)(k - 1), &diff) != 0) {
            return -1;
        }
        if (add_ll(same, diff, &total) != 0) {
            return -1;
        }
    }

    *out = total;
    return 0;
}

int main(void)
{
    int n;
    int k;
    long long result;

    printf("Enter number of posts: ");
    if (scanf("%d", &n) != 1) {
        fprintf(stderr, "Error: invalid input for number of posts\n");
        return EXIT_FAILURE;
    }

    printf("Enter number of colors: ");
    if (scanf("%d", &k) != 1) {
        fprintf(stderr, "Error: invalid input for number of colors\n");
        return EXIT_FAILURE;
    }

    if (n <= 0 || k <= 0) {
        fprintf(stderr, "Error: posts and colors must be positive\n");
        return EXIT_FAILURE;
    }

    if (n > 60 || k > 100000) {
        fprintf(stderr, "Error: input values too large, result may overflow\n");
        return EXIT_FAILURE;
    }

    if (count_ways(n, k, &result) != 0) {
        fprintf(stderr, "Error: computation overflowed\n");
        return EXIT_FAILURE;
    }

    printf("Number of ways: %lld\n", result);

    return EXIT_SUCCESS;
}
```