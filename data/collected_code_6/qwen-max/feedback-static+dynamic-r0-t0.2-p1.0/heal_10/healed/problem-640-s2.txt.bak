```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* remove_parenthesis_area(const char *str) {
    int len = strlen(str);
    int new_len = 0;
    int depth = 0;

    for (int i = 0; i < len; i++) {
        if (str[i] == '(') {
            depth++;
        } else if (str[i] == ')') {
            depth--;
        } else if (depth == 0) {
            new_len++;
        }
    }

    char *result = (char *)malloc(new_len + 1);
    if (result == NULL) return NULL;

    int result_index = 0;
    depth = 0;

    for (int i = 0; i < len; i++) {
        if (depth == 0 && (str[i] != '(' && str[i] != ')')) {
            result[result_index++] = str[i];
        } else if (str[i] == '(') {
            depth++;
        } else if (str[i] == ')') {
            depth--;
        }
    }

    result[result_index] = '\0';
    return result;
}

int main() {
    const char input1[] = "This (is a test)";
    const char input2[] = "(alpha) beta (gamma)";
    const char input3[] = "python (example)";

    char *output1 = remove_parenthesis_area(input1);
    char *output2 = remove_parenthesis_area(input2);
    char *output3 = remove_parenthesis_area(input3);

    if (output1 != NULL) {
        printf("%s\n", output1);
        free(output1);
    } else {
        fprintf(stderr, "Memory allocation failed\n");
    }

    if (output2 != NULL) {
        printf("%s\n", output2);
        free(output2);
    } else {
        fprintf(stderr, "Memory allocation failed\n");
    }

    if (output3 != NULL) {
        printf("%s\n", output3);
        free(output3);
    } else {
        fprintf(stderr, "Memory allocation failed\n");
    }

    return 0;
}
```