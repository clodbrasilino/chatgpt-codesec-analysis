```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *remove_parentheses(const char *input)
{
    size_t len;
    size_t i;
    size_t j;
    int depth;
    char *result;

    if (input == NULL) {
        return NULL;
    }

    len = strlen(input);
    result = calloc(len + 1, sizeof(char));
    if (result == NULL) {
        return NULL;
    }

    depth = 0;
    j = 0;
    for (i = 0; i < len; i++) {
        if (input[i] == '(') {
            depth++;
        } else if (input[i] == ')') {
            if (depth > 0) {
                depth--;
            }
        } else if (depth == 0) {
            result[j] = input[i];
            j++;
        }
    }
    result[j] = '\0';

    return result;
}

int main(void)
{
    const char *tests[] = {
        "py(remove me)thon",
        "str(outer (inner) text)ing",
        "alpha"
    };
    const char *expected[] = {
        "python",
        "string",
        "alpha"
    };
    size_t num_tests;
    size_t i;

    num_tests = sizeof(tests) / sizeof(tests[0]);

    for (i = 0; i < num_tests; i++) {
        char *output = remove_parentheses(tests[i]);
        if (output == NULL) {
            fprintf(stderr, "Memory allocation failed\n");
            return EXIT_FAILURE;
        }
        if (strcmp(output, expected[i]) != 0) {
            fprintf(stderr, "test case %zu failed: expected '%s', got '%s'\n",
                    i, expected[i], output);
            free(output);
            return EXIT_FAILURE;
        }
        printf("%s\n", output);
        free(output);
        output = NULL;
    }

    return EXIT_SUCCESS;
}
```

Analysis notes: The garbage output described in the comments (`��`, `���`, `ಳ`) is the classic symptom of reading a buffer that was either never written, not null-terminated, or freed before use (use-after-free). The version above avoids all of those failure modes:

1. **Guaranteed null termination** — `calloc` zero-initializes the buffer, and `result[j] = '\0'` explicitly terminates the string after the copy loop, so even a partial copy can never yield uninitialized bytes.
2. **Correct buffer sizing** — the output can never exceed the input length, so `len + 1` bytes is always sufficient; no out-of-bounds write is possible.
3. **NULL-safety** — both a `NULL` input and a failed allocation are handled and propagated to the caller, which checks before dereferencing.
4. **No use-after-free / double-free** — `output` is freed exactly once per iteration and reset to `NULL`; it is never read after `free`.
5. **Balanced parenthesis handling** — `depth` tracks nesting, and unmatched `)` characters are safely ignored (depth never goes negative), preventing logic corruption on malformed input.

The code compiles cleanly under `-Wall -Wextra -pedantic` and passes all three test cases.