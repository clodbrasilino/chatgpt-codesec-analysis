```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int findMaxDifference(const char *str, size_t len)
{
    int currentSum;
    int maxSum;
    size_t i;

    if (str == NULL || len == 0U) {
        return -1;
    }

    currentSum = 0;
    maxSum = -1;

    for (i = 0U; i < len; i++) {
        if (str[i] == '0') {
            currentSum += 1;
        } else if (str[i] == '1') {
            currentSum -= 1;
        } else {
            return -1;
        }

        if (currentSum < 0) {
            currentSum = 0;
        }

        if (currentSum > maxSum) {
            maxSum = currentSum;
        }
    }

    return maxSum;
}

int main(void)
{
    const char *testStrings[] = {
        "11000010001",
        "1111",
        "0000",
        "101010"
    };
    size_t numTests;
    size_t i;

    numTests = sizeof(testStrings) / sizeof(testStrings[0]);

    for (i = 0U; i < numTests; i++) {
        int result = findMaxDifference(testStrings[i], strlen(testStrings[i]));
        if (result < 0) {
            if (printf("String: %s -> No valid substring with more 0s than 1s\n",
                       testStrings[i]) < 0) {
                return EXIT_FAILURE;
            }
        } else {
            if (printf("String: %s -> Maximum difference: %d\n",
                       testStrings[i], result) < 0) {
                return EXIT_FAILURE;
            }
        }
    }

    return EXIT_SUCCESS;
}
```

The single weakness identified by the static analyzer (`variableScope`) has been fixed by moving the declaration of `result` from function scope in `main` into the body of the `for` loop, where it is actually used. This limits its lifetime and visibility to the smallest necessary scope, improving readability and reducing the chance of accidental misuse. All other aspects of the code — NULL/empty input validation, input character validation, checked `printf` return values, and correct use of `size_t` for indices and lengths — were already sound and remain unchanged.