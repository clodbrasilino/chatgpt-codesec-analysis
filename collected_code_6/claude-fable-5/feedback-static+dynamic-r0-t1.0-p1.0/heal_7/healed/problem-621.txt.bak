```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <errno.h>
#include <limits.h>

static int is_numeric(const char *s)
{
    size_t i = 0;

    if (s == NULL || s[0] == '\0') {
        return 0;
    }
    if (s[0] == '+' || s[0] == '-') {
        i = 1;
        if (s[1] == '\0') {
            return 0;
        }
    }
    for (; s[i] != '\0'; i++) {
        if (!isdigit((unsigned char)s[i])) {
            return 0;
        }
    }
    return 1;
}

static char *duplicate_string(const char *s)
{
    size_t len;
    char *copy;

    if (s == NULL) {
        return NULL;
    }
    len = strlen(s) + 1;
    copy = malloc(len);
    if (copy == NULL) {
        return NULL;
    }
    memcpy(copy, s, len);
    return copy;
}

static char *duplicate_range(const char *s, size_t len)
{
    char *copy;

    if (s == NULL) {
        return NULL;
    }
    copy = malloc(len + 1);
    if (copy == NULL) {
        return NULL;
    }
    memcpy(copy, s, len);
    copy[len] = '\0';
    return copy;
}

static void free_string_array(char **arr, size_t n)
{
    size_t i;

    if (arr == NULL) {
        return;
    }
    for (i = 0; i < n; i++) {
        free(arr[i]);
        arr[i] = NULL;
    }
    free(arr);
}

static char **split_string(const char *s, char delim, size_t *count)
{
    size_t n = 0;
    size_t i;
    size_t start;
    size_t idx = 0;
    char **result;

    if (count == NULL) {
        return NULL;
    }
    *count = 0;
    if (s == NULL) {
        return NULL;
    }
    n = 1;
    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] == delim) {
            n++;
        }
    }
    result = calloc(n, sizeof(char *));
    if (result == NULL) {
        return NULL;
    }
    start = 0;
    for (i = 0; ; i++) {
        if (s[i] == delim || s[i] == '\0') {
            result[idx] = duplicate_range(s + start, i - start);
            if (result[idx] == NULL) {
                free_string_array(result, idx);
                return NULL;
            }
            idx++;
            start = i + 1;
            if (s[i] == '\0') {
                break;
            }
        }
    }
    *count = n;
    return result;
}

static int parse_long(const char *s, long *out)
{
    char *end;
    long val;

    if (s == NULL || out == NULL || !is_numeric(s)) {
        return 0;
    }
    errno = 0;
    val = strtol(s, &end, 10);
    if (errno == ERANGE || *end != '\0') {
        return 0;
    }
    *out = val;
    return 1;
}

int main(int argc, char *argv[])
{
    const char *input = "12,-34,abc,+56,";
    char **parts;
    size_t count;
    size_t i;
    long value;
    char *copy;

    if (argc > 1) {
        input = argv[1];
    }

    copy = duplicate_string(input);
    if (copy == NULL) {
        fprintf(stderr, "allocation failure\n");
        return EXIT_FAILURE;
    }
    printf("input: %s\n", copy);

    parts = split_string(copy, ',', &count);
    if (parts == NULL) {
        fprintf(stderr, "split failure\n");
        free(copy);
        return EXIT_FAILURE;
    }

    for (i = 0; i < count; i++) {
        if (parse_long(parts[i], &value)) {
            printf("token %zu: \"%s\" -> numeric (%ld)\n", i, parts[i], value);
        } else {
            printf("token %zu: \"%s\" -> not numeric\n", i, parts[i]);
        }
    }

    free_string_array(parts, count);
    free(copy);
    return EXIT_SUCCESS;
}
```