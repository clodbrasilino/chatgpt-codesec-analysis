```c
#include <stdbool.h>
#include <stdlib.h>

bool is_even(int number) {
    return number % 2 == 0;
}

int main(int argc, const char *argv[]) {
    int test_number = 0;
    
    if (argc > 1) {
        test_number = atoi(argv[1]);
    } else {
        test_number = 42;
    }
    
    if (is_even(test_number)) {
        return 0;
    }
    
    return 1;
}
```