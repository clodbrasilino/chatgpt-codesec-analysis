```c
#include <stdio.h>
#include <stdlib.h>
#include <errno.h>
#include <limits.h>

double harmonic_sum(int n)
{
    double sum = 0.0;
    int i;

    if (n <= 0) {
        return 0.0;
    }

    for (i = 1; i <= n; i++) {
        sum += 1.0 / (double)i;
    }

    return sum;
}

int main(void)
{
    int n;
    double result;

    if (scanf("%d", &n) != 1) {
        return EXIT_FAILURE;
    }

    if (n < 1) {
        return EXIT_FAILURE;
    }

    result = harmonic_sum(n);
    printf("%.15f\n", result);

    return EXIT_SUCCESS;
}
```