```c
#include <stdio.h>
#include <stddef.h>
#include <string.h>
#include <stdbool.h>
#include <ctype.h>

static bool is_palindrome(const char *str)
{
    size_t left;
    size_t right;
    size_t len;

    if (str == NULL) {
        return false;
    }

    len = strlen(str);
    if (len == 0U) {
        return false;
    }

    left = 0U;
    right = len - 1U;

    while (left < right) {
        if (tolower((unsigned char)str[left]) != tolower((unsigned char)str[right])) {
            return false;
        }
        left++;
        right--;
    }

    return true;
}

static size_t find_palindromes(const char *const *strings, size_t count,
                               const char **results, size_t results_capacity)
{
    size_t found;

    if ((strings == NULL) || (results == NULL) || (results_capacity == 0U)) {
        return 0U;
    }

    found = 0U;
    for (size_t i = 0U; i < count; i++) {
        if (is_palindrome(strings[i])) {
            if (found < results_capacity) {
                results[found] = strings[i];
                found++;
            } else {
                break;
            }
        }
    }

    return found;
}

int main(void)
{
    const char *const words[] = {
        "racecar",
        "hello",
        "Level",
        "world",
        "noon",
        "example",
        "madam"
    };
    const size_t word_count = sizeof(words) / sizeof(words[0]);
    const char *palindromes[sizeof(words) / sizeof(words[0])];
    size_t found;

    found = find_palindromes(words, word_count, palindromes, word_count);

    if (found == 0U) {
        if (puts("No palindromes found.") == EOF) {
            return 1;
        }
    } else {
        if (printf("Found %zu palindrome(s):\n", found) < 0) {
            return 1;
        }
        for (size_t i = 0U; i < found; i++) {
            if (printf("%s\n", palindromes[i]) < 0) {
                return 1;
            }
        }
    }

    return 0;
}
```

The fix applied for the identified weakness: the variable `i` previously declared at function scope in `main` (and in `find_palindromes`) has been moved into the `for` loop initializers, reducing its scope to where it is actually used. This addresses the `[variableScope]` static-analysis finding while preserving identical behavior. All error checks on `puts` and `printf` return values remain intact, as do the defensive `NULL` and capacity checks.