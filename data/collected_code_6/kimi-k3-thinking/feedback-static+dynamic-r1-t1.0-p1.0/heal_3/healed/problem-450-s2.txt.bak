```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void free_strings(char **strings, size_t count)
{
    size_t i;

    if (strings == NULL) {
        return;
    }

    for (i = 0; i < count; i++) {
        free(strings[i]);
    }
    free(strings);
}

char **extract_strings(const char *const *strings, size_t count, size_t size, size_t *out_count)
{
    char **result;
    size_t i;

    if (out_count == NULL) {
        return NULL;
    }

    *out_count = 0;

    if (strings == NULL || count == 0) {
        return NULL;
    }

    result = calloc(count, sizeof(*result));
    if (result == NULL) {
        return NULL;
    }

    for (i = 0; i < count; i++) {
        size_t len;

        if (strings[i] == NULL) {
            continue;
        }

        len = strlen(strings[i]);
        if (len != size) {
            continue;
        }

        result[*out_count] = malloc(len + 1);
        if (result[*out_count] == NULL) {
            free_strings(result, *out_count);
            return NULL;
        }

        memcpy(result[*out_count], strings[i], len + 1);
        (*out_count)++;
    }

    return result;
}

int is_number(const char *s)
{
    if (s == NULL || *s == '\0') {
        return 0;
    }

    while (*s != '\0') {
        if (*s < '0' || *s > '9') {
            return 0;
        }
        s++;
    }

    return 1;
}

int add_token(char ***values, size_t *count, size_t *capacity, const char *token)
{
    char *copy;

    if (*count == *capacity) {
        size_t new_capacity = (*capacity == 0) ? 8 : (*capacity * 2);
        char **new_values = realloc(*values, new_capacity * sizeof(*new_values));
        if (new_values == NULL) {
            return 0;
        }
        *values = new_values;
        *capacity = new_capacity;
    }

    copy = malloc(strlen(token) + 1);
    if (copy == NULL) {
        return 0;
    }
    strcpy(copy, token);
    (*values)[*count] = copy;
    (*count)++;

    return 1;
}

int add_tokens(char ***values, size_t *count, size_t *capacity, const char *text)
{
    char *dup;
    char *tok;
    int ok = 1;

    dup = malloc(strlen(text) + 1);
    if (dup == NULL) {
        return 0;
    }
    strcpy(dup, text);

    for (tok = strtok(dup, " \t\n\r\f\v"); tok != NULL; tok = strtok(NULL, " \t\n\r\f\v")) {
        if (!add_token(values, count, capacity, tok)) {
            ok = 0;
            break;
        }
    }

    free(dup);
    return ok;
}

int main(int argc, char **argv)
{
    char **values = NULL;
    size_t count = 0;
    size_t capacity = 0;
    char buffer[4096];
    char **extracted = NULL;
    size_t extracted_count = 0;
    size_t size = 0;
    size_t size_index = 0;
    size_t i;
    int size_found = 0;
    int ok = 1;

    if (argc > 1) {
        for (i = 1; i < (size_t)argc; i++) {
            if (!add_tokens(&values, &count, &capacity, argv[i])) {
                ok = 0;
                break;
            }
        }
    } else {
        while (scanf("%4095s", buffer) == 1) {
            if (!add_token(&values, &count, &capacity, buffer)) {
                ok = 0;
                break;
            }
        }
    }

    if (!ok) {
        free_strings(values, count);
        return EXIT_FAILURE;
    }

    if (count > 0 && is_number(values[count - 1])) {
        size_index = count - 1;
        size_found = 1;
    } else if (count > 0 && is_number(values[0])) {
        size_index = 0;
        size_found = 1;
    } else {
        for (i = 0; i < count; i++) {
            if (is_number(values[i])) {
                size_index = i;
                size_found = 1;
                break;
            }
        }
    }

    if (size_found) {
        size = (size_t)strtoull(values[size_index], NULL, 10);
    }

    if (size_found && count > 1) {
        char **candidates = malloc((count - 1) * sizeof(*candidates));
        if (candidates == NULL) {
            free_strings(values, count);
            return EXIT_FAILURE;
        }

        {
            size_t j = 0;
            for (i = 0; i < count; i++) {
                if (i != size_index) {
                    candidates[j++] = values[i];
                }
            }
            extracted = extract_strings((const char *const *)candidates, count - 1, size, &extracted_count);
        }

        free(candidates);

        if (extracted == NULL) {
            free_strings(values, count);
            return EXIT_FAILURE;
        }
    }

    printf("[");
    for (i = 0; i < extracted_count; i++) {
        printf("%s'%s'", (i == 0) ? "" : ", ", extracted[i]);
    }
    printf("]\n");
    fflush(stdout);

    free_strings(extracted, extracted_count);
    free_strings(values, count);

    return EXIT_SUCCESS;
}
```