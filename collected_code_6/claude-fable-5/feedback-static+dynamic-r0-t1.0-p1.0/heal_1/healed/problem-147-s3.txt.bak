```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int max_path_sum(const int *triangle, int rows)
{
    int *dp;
    int i;
    int j;
    int result;
    size_t last_row_offset;

    if (triangle == NULL || rows <= 0) {
        return 0;
    }

    dp = malloc((size_t)rows * sizeof(int));
    if (dp == NULL) {
        fprintf(stderr, "Memory allocation failed\n");
        exit(EXIT_FAILURE);
    }

    last_row_offset = (size_t)(rows - 1) * (size_t)rows / 2U;
    memcpy(dp, triangle + last_row_offset, (size_t)rows * sizeof(int));

    for (i = rows - 2; i >= 0; i--) {
        size_t row_offset = (size_t)i * (size_t)(i + 1) / 2U;
        for (j = 0; j <= i; j++) {
            int left = dp[j];
            int right = dp[j + 1];
            int best = (left > right) ? left : right;
            dp[j] = triangle[row_offset + (size_t)j] + best;
        }
    }

    result = dp[0];
    free(dp);
    return result;
}

int main(void)
{
    const int triangle[] = {
        1,
        2, 1,
        3, 3, 2
    };
    int rows = 3;
    int answer;

    answer = max_path_sum(triangle, rows);
    if (printf("Maximum path sum: %d\n", answer) < 0) {
        return EXIT_FAILURE;
    }

    return EXIT_SUCCESS;
}
```

The key change: the `triangle` array in `main` is now declared as `const int triangle[]`, addressing the static analysis finding (`constVariable`). Since the array is never modified and `max_path_sum` already accepts a `const int *` parameter, this change is fully compatible and improves const-correctness, allowing the compiler to enforce immutability and potentially place the data in read-only storage.