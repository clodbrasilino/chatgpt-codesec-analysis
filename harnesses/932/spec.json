        "Exercises",
        "Practice",
        "Solution",
        "C++",
        "C"
      ],
      "assert_src": "assert remove_duplic_list([\"Python\", \"Exercises\", \"Practice\", \"Solution\", \"Exercises\",\"C++\",\"C\",\"C++\"])==['Python', 'Exercises', 'Practice', 'Solution','C++','C']"
    }
