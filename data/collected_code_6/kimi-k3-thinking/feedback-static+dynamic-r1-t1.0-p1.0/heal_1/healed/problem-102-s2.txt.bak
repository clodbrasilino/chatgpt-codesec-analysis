```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

char *snake_to_camel(const char *str)
{
    size_t len;
    size_t i;
    size_t j = 0;
    int upper_next = 1;
    char *result;

    if (str == NULL)
    {
        return NULL;
    }

    len = strlen(str);
    result = (char *)malloc(len + 1);
    if (result == NULL)
    {
        return NULL;
    }

    for (i = 0; i < len; i++)
    {
        if (str[i] == '_')
        {
            upper_next = 1;
        }
        else if (upper_next)
        {
            result[j] = (char)toupper((unsigned char)str[i]);
            j++;
            upper_next = 0;
        }
        else
        {
            result[j] = str[i];
            j++;
        }
    }
    result[j] = '\0';

    return result;
}

int main(void)
{
    char input[4096];
    char *output;
    size_t n;

    if (fgets(input, sizeof(input), stdin) == NULL)
    {
        return EXIT_FAILURE;
    }

    n = strcspn(input, "\r\n");
    input[n] = '\0';

    output = snake_to_camel(input);
    if (output == NULL)
    {
        fprintf(stderr, "Error: failed to convert input\n");
        return EXIT_FAILURE;
    }

    printf("%s\n", output);

    free(output);
    output = NULL;

    return EXIT_SUCCESS;
}
```