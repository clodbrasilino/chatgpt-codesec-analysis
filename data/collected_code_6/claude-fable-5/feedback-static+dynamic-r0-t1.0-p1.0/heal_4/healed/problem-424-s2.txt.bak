```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *extract_rear(const char *const *strings, size_t count)
{
    char *result = NULL;
    size_t i;

    if (strings == NULL || count == 0U) {
        return NULL;
    }

    result = (char *)malloc(count + 1U);
    if (result == NULL) {
        return NULL;
    }

    for (i = 0U; i < count; i++) {
        size_t len;

        if (strings[i] == NULL) {
            free(result);
            return NULL;
        }

        len = strlen(strings[i]);
        if (len == 0U) {
            result[i] = ' ';
        } else {
            result[i] = strings[i][len - 1U];
        }
    }

    result[count] = '\0';
    return result;
}

int print_rear(const char *rear, size_t count)
{
    size_t i;

    if (rear == NULL) {
        return -1;
    }

    if (fputs("[", stdout) == EOF) {
        return -1;
    }

    for (i = 0U; i < count; i++) {
        if (printf("'%c'", rear[i]) < 0) {
            return -1;
        }
        if (i + 1U < count) {
            if (fputs(", ", stdout) == EOF) {
                return -1;
            }
        }
    }

    if (fputs("]\n", stdout) == EOF) {
        return -1;
    }

    if (fflush(stdout) != 0) {
        return -1;
    }

    return 0;
}

int run_case(const char *const *words, size_t count)
{
    char *rear;
    int status;

    rear = extract_rear(words, count);
    if (rear == NULL) {
        fprintf(stderr, "Failed to extract rear elements\n");
        return -1;
    }

    status = print_rear(rear, count);
    free(rear);

    if (status != 0) {
        return -1;
    }

    return 0;
}

int main(void)
{
    const char *const words0[] = { "Mers", "for", "Vers" };
    const char *const words1[] = { "blue", "star", "tree" };
    const char *const words2[] = { "pizza", "cat", "hello" };

    if (run_case(words0, sizeof(words0) / sizeof(words0[0])) != 0) {
        return EXIT_FAILURE;
    }

    if (run_case(words1, sizeof(words1) / sizeof(words1[0])) != 0) {
        return EXIT_FAILURE;
    }

    if (run_case(words2, sizeof(words2) / sizeof(words2[0])) != 0) {
        return EXIT_FAILURE;
    }

    return EXIT_SUCCESS;
}
```

**Analysis notes:**

The original logic was actually sound — `extract_rear` correctly pulls the last character of each string, and the expected outputs (`['s', 'r', 's']`, `['e', 'r', 'e']`, `['a', 't', 'o']`) match what the algorithm produces for the three test arrays. The reported "no output" failures point to output delivery rather than logic, typically caused by unflushed/buffered stdout when the test harness captures output, or by an early abort before printing.

Key points addressed in the rewrite:

1. **Guaranteed flush** — `fflush(stdout)` is retained after each case so buffered output is never lost if the harness kills or pipes the process.
2. **No leak on print failure** — `free(rear)` now happens exactly once on every path in `run_case`, before the status check, eliminating the duplicated cleanup branches.
3. **Robust NULL handling** — `extract_rear` still rejects a NULL array, NULL elements, and zero count, freeing any partial allocation before returning.
4. **Explicit cast on `malloc`** — harmless in C, but makes the code compile cleanly if ever pulled into a C++ translation unit.
5. **`fputs` for fixed strings** — avoids format-string processing for literals and keeps the error-checking pattern consistent (`EOF` check instead of `< 0`).

Expected output when run:

```
['s', 'r', 's']
['e', 'r', 'e']
['a', 't', 'o']
```