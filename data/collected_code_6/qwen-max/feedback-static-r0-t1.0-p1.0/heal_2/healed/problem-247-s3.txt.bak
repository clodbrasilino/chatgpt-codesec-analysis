```c
#include <stdio.h>
#include <string.h>

int lcs(const char *X, const char *Y, int m, int n) {
    int L[m + 1][n + 1];
    for (int i = 0; i <= m; i++) {
        for (int j = 0; j <= n; j++) {
            if (i == 0 || j == 0)
                L[i][j] = 0;
            else if (X[i - 1] == Y[j - 1])
                L[i][j] = L[i - 1][j - 1] + 1;
            else
                L[i][j] = (L[i - 1][j] > L[i][j - 1]) ? L[i - 1][j] : L[i][j - 1];
        }
    }
    return L[m][n];
}

int longestPalSubseq(const char *str) {
    int n = strlen(str);
    char revStr[n + 1];
    for (int i = 0; i < n; i++)
        revStr[i] = str[n - 1 - i];
    revStr[i] = '\0';

    return lcs(str, revStr, n, n);
}

int main() {
    const char str[] = "agbdba";
    printf("The length of the longest palindromic subsequence is %d\n", longestPalSubseq(str));
    return 0;
}
```