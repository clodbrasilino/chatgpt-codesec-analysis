```c
#include <stdio.h>

int main(void) {
    char word[1024];
    int first = 1;
    
    printf("[");
    while (scanf("%1023s", word) == 1) {
        if (!first) {
            printf(", ");
        }
        printf("'%s'", word);
        first = 0;
    }
    printf("]\n");
    
    return 0;
}
```