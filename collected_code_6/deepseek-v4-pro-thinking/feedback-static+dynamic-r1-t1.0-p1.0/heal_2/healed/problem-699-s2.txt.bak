```c
#include <stdio.h>
#include <string.h>

long long minSwaps(const char *s, const char *t) {
    if (s == NULL || t == NULL) {
        return -1;
    }

    size_t n = strlen(s);
    if (n != strlen(t)) {
        return -1;
    }

    long long ones_s = 0;
    long long ones_t = 0;
    long long diff = 0;

    for (size_t i = 0; i < n; i++) {
        if ((s[i] != '0' && s[i] != '1') ||
            (t[i] != '0' && t[i] != '1')) {
            return -1;
        }
        if (s[i] == '1') {
            ones_s++;
            if (t[i] == '0') {
                diff++;
            }
        }
        if (t[i] == '1') {
            ones_t++;
        }
    }

    if (ones_s != ones_t) {
        return -1;
    }

    return diff;
}

int main(int argc, char **argv) {
    if (argc != 3) {
        fprintf(stderr, "Usage: program <binary_string1> <binary_string2>\n");
        return 1;
    }

    long long result = minSwaps(argv[1], argv[2]);
    if (result < 0) {
        printf("Not Possible\n");
        return 0;
    }

    printf("%lld\n", result);
    return 0;
}
```