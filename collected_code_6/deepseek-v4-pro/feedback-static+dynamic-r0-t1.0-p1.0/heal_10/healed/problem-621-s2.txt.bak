```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <limits.h>

char* increment_numeric_values(const char* input, int k) {
    if (input == NULL) {
        return NULL;
    }
    
    size_t input_len = strlen(input);
    size_t max_result_size = input_len * 20 + 1;
    char* result = (char*)malloc(max_result_size);
    if (result == NULL) {
        return NULL;
    }
    
    size_t result_pos = 0;
    size_t i = 0;
    
    while (i < input_len) {
        if (isdigit((unsigned char)input[i])) {
            size_t start = i;
            while (i < input_len && isdigit((unsigned char)input[i])) {
                i++;
            }
            
            size_t num_len = i - start;
            char* num_str = (char*)malloc(num_len + 1);
            if (num_str == NULL) {
                free(result);
                return NULL;
            }
            
            strncpy(num_str, input + start, num_len);
            num_str[num_len] = '\0';
            
            long long num = atoll(num_str);
            free(num_str);
            
            long long new_num;
            if (k > 0 && num > LLONG_MAX - k) {
                free(result);
                return NULL;
            }
            if (k < 0 && num < LLONG_MIN - k) {
                free(result);
                return NULL;
            }
            new_num = num + k;
            
            char new_num_str[64];
            int written = snprintf(new_num_str, sizeof(new_num_str), "%lld", new_num);
            if (written < 0) {
                free(result);
                return NULL;
            }
            
            size_t new_num_len = strlen(new_num_str);
            if (result_pos + new_num_len >= max_result_size) {
                free(result);
                return NULL;
            }
            
            strcpy(result + result_pos, new_num_str);
            result_pos += new_num_len;
        } else {
            if (result_pos >= max_result_size - 1) {
                free(result);
                return NULL;
            }
            result[result_pos++] = input[i++];
        }
    }
    
    result[result_pos] = '\0';
    return result;
}

int main(void) {
    const char* test1 = "I have 10 apples and 5 oranges";
    const char* test2 = "Numbers: 1, 2, 3, 100";
    const char* test3 = "No numbers here";
    const char* test4 = "Edge case 999999999999999999";
    const char* test5 = "";
    const char* test6 = "MSM 240 is 104 129 best 10";
    const char* test7 = "Dart 368 is 100 181 Super 18";
    const char* test8 = "Flutter 484 is 77 129 Magnificent 45";
    
    char* result1 = increment_numeric_values(test1, 5);
    char* result2 = increment_numeric_values(test2, -2);
    char* result3 = increment_numeric_values(test3, 10);
    char* result4 = increment_numeric_values(test4, 1);
    char* result5 = increment_numeric_values(test5, 3);
    char* result6 = increment_numeric_values(test6, 0);
    char* result7 = increment_numeric_values(test7, 0);
    char* result8 = increment_numeric_values(test8, 0);
    char* result9 = increment_numeric_values(NULL, 5);
    
    printf("Original: %s\n", test1);
    printf("Result (+5): %s\n\n", result1 ? result1 : "(null)");
    free(result1);
    
    printf("Original: %s\n", test2);
    printf("Result (-2): %s\n\n", result2 ? result2 : "(null)");
    free(result2);
    
    printf("Original: %s\n", test3);
    printf("Result (+10): %s\n\n", result3 ? result3 : "(null)");
    free(result3);
    
    printf("Original: %s\n", test4);
    printf("Result (+1): %s\n\n", result4 ? result4 : "(null)");
    free(result4);
    
    printf("Original: '%s'\n", test5);
    printf("Result (+3): '%s'\n\n", result5 ? result5 : "(null)");
    free(result5);
    
    printf("Original: %s\n", test6);
    printf("Result (+0): %s\n\n", result6 ? result6 : "(null)");
    free(result6);
    
    printf("Original: %s\n", test7);
    printf("Result (+0): %s\n\n", result7 ? result7 : "(null)");
    free(result7);
    
    printf("Original: %s\n", test8);
    printf("Result (+0): %s\n\n", result8 ? result8 : "(null)");
    free(result8);
    
    printf("Original: NULL\n");
    printf("Result: %s\n", result9 ? result9 : "(null)");
    free(result9);
    
    return 0;
}
```