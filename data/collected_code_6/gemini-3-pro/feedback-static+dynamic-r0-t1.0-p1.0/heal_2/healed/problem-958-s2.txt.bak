```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* intToRoman(int num) {
    if (num <= 0 || num > 3999) {
        return NULL;
    }

    const int values[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    const char* const symbols[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    
    char* roman = (char*)calloc(16, sizeof(char));
    if (!roman) {
        return NULL;
    }

    int i = 0;
    while (num > 0) {
        while (num >= values[i]) {
            num -= values[i];
            strcat(roman, symbols[i]);
        }
        i++;
    }

    return roman;
}

int main(void) {
    int num;
    if (scanf("%d", &num) == 1) {
        char* roman = intToRoman(num);
        if (roman) {
            printf("%s", roman);
            free(roman);
        }
    }
    return 0;
}
```