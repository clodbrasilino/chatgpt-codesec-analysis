#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

int read_int(int *val) {
    int c;
    int sign = 1;
    while ((c = getchar()) != EOF && !isdigit(c) && c != '-');
    if (c == EOF) return 0;
    if (c == '-') {
        sign = -1;
        c = getchar();
        if (c == EOF || !isdigit(c)) {
            if (c != EOF) ungetc(c, stdin);
            return 0;
        }
    }
    *val = c - '0';
    while ((c = getchar()) != EOF && isdigit(c)) {
        *val = *val * 10 + (c - '0');
    }
    *val *= sign;
    if (c != EOF && !isdigit(c)) {
        ungetc(c, stdin);
    }
    return 1;
}

