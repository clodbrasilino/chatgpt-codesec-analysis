```c
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

long long rencontres_number(int n) {
    if (n < 0) {
        return -1;
    }
    if (n == 0) {
        return 1;
    }
    if (n == 1) {
        return 0;
    }

    long long *dp = (long long *)malloc((n + 1) * sizeof(long long));
    if (dp == NULL) {
        return -1;
    }

    dp[0] = 1;
    dp[1] = 0;

    for (int i = 2; i <= n; i++) {
        if (dp[i - 1] > 0 && dp[i - 1] > LLONG_MAX - dp[i - 2]) {
            free(dp);
            return -1;
        }
        long long sum = dp[i - 1] + dp[i - 2];

        if (sum > 0 && i - 1 > LLONG_MAX / sum) {
            free(dp);
            return -1;
        }
        dp[i] = (long long)(i - 1) * sum;
    }

    long long result = dp[n];
    free(dp);
    return result;
}

int main(void) {
    int n;
    printf("Enter n: ");
    if (scanf("%d", &n) != 1) {
        fprintf(stderr, "Invalid input\n");
        return 1;
    }

    long long result = rencontres_number(n);
    if (result < 0) {
        fprintf(stderr, "Error computing rencontres number\n");
        return 1;
    }

    printf("D_%d = %lld\n", n, result);
    return 0;
}
