```c
#include <stdio.h>
#include <math.h>
#include <float.h>
#include <limits.h>

int find_smallest_triangular_index(int n) {
    if (n <= 0) return -1;
    double lower_bound = pow(10, (n-1));
    if (lower_bound > (DBL_MAX - 1) / 8) return INT_MAX;
    double root = (sqrt(1 + 8 * lower_bound) - 1) / 2;
    if (root > INT_MAX) return INT_MAX;
    return (int)ceil(root);
}

int main() {
    int n;
    printf("Enter the number of digits: ");
    scanf("%d", &n);
    if (n <= 0) {
        return 1;
    }
    int index = find_smallest_triangular_index(n);
    if (index == INT_MAX) {
        printf("The index is too large to be represented.\n");
    } else {
        printf("The index of the smallest triangular number with %d digits is: %d\n", n, index);
    }
    return 0;
}
```