```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

char* snake_to_camel(const char* snake_str) {
    if (snake_str == NULL) {
        return NULL;
    }

    size_t len = strlen(snake_str);
    char* camel_str = (char*)malloc(len + 1);
    if (camel_str == NULL) {
        return NULL;
    }

    int capitalize_next = 1;
    char* out_cursor = camel_str;

    for (const char* cursor = snake_str; *cursor != '\0'; cursor++) {
        if (*cursor == '_') {
            capitalize_next = 1;
        } else {
            if (capitalize_next) {
                *out_cursor++ = toupper((unsigned char)*cursor);
                capitalize_next = 0;
            } else {
                *out_cursor++ = *cursor; /* Or tolower(*cursor) if strict lowercase input isn't guaranteed */
            }
        }
    }
    *out_cursor = '\0';

    return camel_str;
}

int main(void) {
    const char* snake = "this_is_a_snake_case_string";
    char* camel = snake_to_camel(snake);

    if (camel != NULL) {
        printf("%s\n", camel);
        free(camel);
    }

    return 0;
}
```