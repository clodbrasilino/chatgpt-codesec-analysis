```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <ctype.h>

typedef struct {
    char *items;
    size_t count;
} Tuple;

Tuple *string_to_tuple(const char *input)
{
    Tuple *tuple = NULL;
    size_t capacity = 4;
    size_t count = 0;
    size_t i;
    size_t len;
    char *items = NULL;
    char *resized = NULL;

    if (input == NULL) {
        return NULL;
    }

    len = strlen(input);

    items = malloc(capacity * sizeof(char));
    if (items == NULL) {
        return NULL;
    }

    for (i = 0; i < len; i++) {
        if (isspace((unsigned char)input[i])) {
            continue;
        }

        if (count + 1 >= capacity) {
            if (capacity > SIZE_MAX / 2) {
                free(items);
                return NULL;
            }
            capacity *= 2;
            resized = realloc(items, capacity * sizeof(char));
            if (resized == NULL) {
                free(items);
                return NULL;
            }
            items = resized;
        }

        items[count] = input[i];
        count++;
    }

    if (count == 0) {
        free(items);
        return NULL;
    }

    items[count] = '\0';

    tuple = malloc(sizeof(Tuple));
    if (tuple == NULL) {
        free(items);
        return NULL;
    }

    tuple->items = items;
    tuple->count = count;
    return tuple;
}

void free_tuple(Tuple *tuple)
{
    if (tuple != NULL) {
        free(tuple->items);
        free(tuple);
    }
}

void print_tuple(const Tuple *tuple)
{
    size_t i;

    if (tuple == NULL || tuple->items == NULL || tuple->count == 0) {
        return;
    }

    printf("[");
    for (i = 0; i < tuple->count; i++) {
        printf("'%c'", tuple->items[i]);
        if (i + 1 < tuple->count) {
            printf(", ");
        }
    }
    printf("]\n");
    fflush(stdout);
}

int main(void)
{
    const char *inputs[] = {
        "python 3.0",
        "item1",
        "15.10"
    };
    size_t num_inputs = sizeof(inputs) / sizeof(inputs[0]);
    size_t i;
    int status = EXIT_SUCCESS;

    setvbuf(stdout, NULL, _IONBF, 0);

    for (i = 0; i < num_inputs; i++) {
        Tuple *tuple = string_to_tuple(inputs[i]);

        if (tuple == NULL) {
            fprintf(stderr, "Failed to convert string to tuple: \"%s\"\n", inputs[i]);
            status = EXIT_FAILURE;
            continue;
        }

        print_tuple(tuple);

        free_tuple(tuple);
    }

    return status;
}
```

**Analysis notes:**

The core logic of the original code was actually sound — the reported "no output" failures typically stem from environment/runtime issues rather than logic errors. Key points verified in this rewrite:

1. **Buffer capacity guarantee:** The check `count + 1 >= capacity` ensures there's always room for the null terminator written at `items[count]` after the loop — no off-by-one overflow.

2. **Overflow protection:** The `capacity > SIZE_MAX / 2` guard prevents integer overflow before doubling capacity.

3. **Memory safety:** Every error path frees previously allocated memory (`items`, `tuple`), and `realloc` failure doesn't leak the original buffer since the result is stored in `resized` first.

4. **Output flushing:** Both `setvbuf(stdout, NULL, _IONBF, 0)` (unbuffered mode) and explicit `fflush(stdout)` after printing guarantee output appears even if the process terminates abnormally — this addresses the "<no output>" symptom, which is often caused by buffered stdout never being flushed in test harnesses using pipes.

5. **`isspace` safety:** The cast to `(unsigned char)` avoids undefined behavior for characters with negative values.

Expected output:
```
['p', 'y', 't', 'h', 'o', 'n', '3', '.', '0']
['i', 't', 'e', 'm', '1']
['1', '5', '.', '1', '0']
```