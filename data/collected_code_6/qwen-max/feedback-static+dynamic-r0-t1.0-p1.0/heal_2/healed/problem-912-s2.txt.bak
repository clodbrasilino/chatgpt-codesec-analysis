```c
#include <stdio.h>
#include <stdlib.h>

long long ln_m_lobb(long n) {
    if (n <= 1) return 0;
    long long a = 2, b = 4, c = 0;
    for (long i = 3; i <= n; ++i) {
        c = (a + b) % 1000000007;
        a = b;
        b = c;
    }
    return c;
}

int main() {
    char input[64];
    fgets(input, sizeof(input), stdin);
    long n;
    if (sscanf(input, "%ld", &n) != 1) {
        fprintf(stderr, "Invalid input\n");
        return EXIT_FAILURE;
    }
    long long result = ln_m_lobb(n);
    printf("The Lobb number is: %lld\n", result);
    return EXIT_SUCCESS;
}
```