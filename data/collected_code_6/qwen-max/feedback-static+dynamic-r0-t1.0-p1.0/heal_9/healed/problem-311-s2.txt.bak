```c
#include <stdio.h>
#include <limits.h>
#include <stdbool.h>

long setLeftMostUnsetBit(long n) {
    long result = n;
    int bits = sizeof(n) * CHAR_BIT - 1;
    for (int i = bits; i >= 0; --i) {
        if (!(n & ((unsigned long)1 << i))) {
            result |= ((unsigned long)1 << i);
            return result;
        }
    }
    return -1;
}

int main() {
    long n;
    printf("Enter a number: ");
    if (scanf("%ld", &n) == 1) {
        long newNumber = setLeftMostUnsetBit(n);
        if (newNumber != -1) {
            printf("New number with the leftmost unset bit set: %ld\n", newNumber);
        } else {
            printf("All bits are set.\n");
        }
    } else {
        printf("Invalid input.\n");
    }
    return 0;
}
```