```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <errno.h>
#include <limits.h>

static int is_numeric(const char *s)
{
    size_t i = 0;

    if (s == NULL || s[0] == '\0') {
        return 0;
    }
    if (s[0] == '+' || s[0] == '-') {
        i = 1;
        if (s[1] == '\0') {
            return 0;
        }
    }
    for (; s[i] != '\0'; i++) {
        if (!isdigit((unsigned char)s[i])) {
            return 0;
        }
    }
    return 1;
}

static char *duplicate_string(const char *s)
{
    size_t len;
    char *copy;

    if (s == NULL) {
        return NULL;
    }
    len = strlen(s) + 1;
    copy = malloc(len);
    if (copy == NULL) {
        return NULL;
    }
    memcpy(copy, s, len);
    return copy;
}

static void free_string_array(char **arr, size_t n)
{
    size_t i;

    if (arr == NULL) {
        return;
    }
    for (i = 0; i < n; i++) {
        free(arr[i]);
    }
    free(arr);
}

static void sanitize_token(char *s)
{
    size_t r = 0;
    size_t w = 0;

    if (s == NULL) {
        return;
    }
    while (s[r] != '\0') {
        char c = s[r];
        if (c != '[' && c != ']' && c != '\'' && c != '"' && c != ',') {
            s[w++] = c;
        }
        r++;
    }
    s[w] = '\0';
}

static char **increment_numeric_strings(const char *const *input, size_t n, long k)
{
    char **result;
    size_t i;

    if (input == NULL || n == 0) {
        return NULL;
    }
    result = calloc(n, sizeof(char *));
    if (result == NULL) {
        return NULL;
    }
    for (i = 0; i < n; i++) {
        if (input[i] == NULL) {
            free_string_array(result, i);
            return NULL;
        }
        if (is_numeric(input[i])) {
            long value;
            char *endptr;
            char buffer[64];
            int written;

            errno = 0;
            value = strtol(input[i], &endptr, 10);
            if (errno == ERANGE || *endptr != '\0') {
                free_string_array(result, i);
                return NULL;
            }
            if ((k > 0 && value > LONG_MAX - k) ||
                (k < 0 && value < LONG_MIN - k)) {
                free_string_array(result, i);
                return NULL;
            }
            value += k;
            written = snprintf(buffer, sizeof(buffer), "%ld", value);
            if (written < 0 || (size_t)written >= sizeof(buffer)) {
                free_string_array(result, i);
                return NULL;
            }
            result[i] = duplicate_string(buffer);
        } else {
            result[i] = duplicate_string(input[i]);
        }
        if (result[i] == NULL) {
            free_string_array(result, i);
            return NULL;
        }
    }
    return result;
}

static char **read_tokens(size_t *count_out)
{
    char **tokens = NULL;
    size_t count = 0;
    size_t capacity = 0;
    char buffer[256];

    while (scanf("%255s", buffer) == 1) {
        sanitize_token(buffer);
        if (buffer[0] == '\0') {
            continue;
        }
        if (count == capacity) {
            size_t new_capacity = (capacity == 0) ? 8 : capacity * 2;
            char **tmp = realloc(tokens, new_capacity * sizeof(char *));
            if (tmp == NULL) {
                free_string_array(tokens, count);
                return NULL;
            }
            tokens = tmp;
            capacity = new_capacity;
        }
        tokens[count] = duplicate_string(buffer);
        if (tokens[count] == NULL) {
            free_string_array(tokens, count);
            return NULL;
        }
        count++;
    }
    *count_out = count;
    return tokens;
}

static int print_string_list(char **arr, size_t n)
{
    size_t i;

    if (printf("[") < 0) {
        return -1;
    }
    for (i = 0; i < n; i++) {
        if (i > 0) {
            if (printf(", ") < 0) {
                return -1;
            }
        }
        if (printf("'%s'", arr[i]) < 0) {
            return -1;
        }
    }
    if (printf("]\n") < 0) {
        return -1;
    }
    return 0;
}

int main(void)
{
    char **tokens;
    char **updated;
    size_t count = 0;
    size_t n;
    long k;
    char *endptr;

    tokens = read_tokens(&count);
    if (tokens == NULL || count < 2) {
        fprintf(stderr, "Failed to read input\n");
        free_string_array(tokens, count);
        return EXIT_FAILURE;
    }

    errno = 0;
    k = strtol(tokens[count - 1], &endptr, 10);
    if (errno == ERANGE || *endptr != '\0' || endptr == tokens[count - 1]) {
        fprintf(stderr, "Invalid increment value\n");
        free_string_array(tokens, count);
        return EXIT_FAILURE;
    }

    n = count - 1;
    updated = increment_numeric_strings((const char *const *)tokens, n, k);
    if (updated == NULL) {
        fprintf(stderr, "Failed to process strings\n");
        free_string_array(tokens, count);
        return EXIT_FAILURE;
    }

    if (print_string_list(updated, n) < 0) {
        free_string_array(updated, n);
        free_string_array(tokens, count);
        return EXIT_FAILURE;
    }

    free_string_array(updated, n);
    free_string_array(tokens, count);
    return EXIT_SUCCESS;
}
```

The key fix addressing the reported test failures: the original program printed each token on its own line and also echoed the increment value `k` as a trailing line, while the expected output is a Python-style list representation (e.g. `['MSM', '240', 'is', '104', '129', 'best', '10']`) containing only the processed strings. The rewritten version adds `print_string_list`, which prints the updated tokens as a bracketed, comma-separated, single-quoted list, and no longer prints the increment value separately — matching all three expected test outputs, since every numeric token in the list (including a trailing numeric element that is part of the list itself) is incremented by `k`.