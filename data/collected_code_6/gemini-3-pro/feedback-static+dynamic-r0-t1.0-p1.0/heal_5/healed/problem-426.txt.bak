```c
#include <stdio.h>
#include <stdlib.h>

int* filter_odd_numbers(const int* array, size_t size, size_t* out_size) {
    if (out_size) {
        *out_size = 0;
    }
    if (array == NULL || out_size == NULL) {
        return NULL;
    }

    size_t count = 0;
    for (size_t i = 0; i < size; ++i) {
        if (array[i] % 2 != 0) {
            count++;
        }
    }

    *out_size = count;

    if (count == 0) {
        return NULL;
    }

    int* odd_array = (int*)malloc(count * sizeof(int));
    if (odd_array == NULL) {
        *out_size = 0;
        return NULL;
    }

    size_t index = 0;
    for (size_t i = 0; i < size; ++i) {
        if (array[i] % 2 != 0) {
            odd_array[index++] = array[i];
        }
    }

    return odd_array;
}

int main(int argc, const char *argv[]) {
    int cap = 10;
    int size = 0;
    int* numbers = (int*)malloc(cap * sizeof(int));
    if (!numbers) return 1;

    if (argc > 1) {
        for (int i = 1; i < argc; ++i) {
            if (size == cap) {
                cap *= 2;
                int* next = (int*)realloc(numbers, cap * sizeof(int));
                if (!next) { 
                    free(numbers); 
                    return 1; 
                }
                numbers = next;
            }
            numbers[size++] = atoi(argv[i]);
        }
    } else {
        int val;
        while (1) {
            int ret = scanf("%d", &val);
            if (ret == 1) {
                if (size == cap) {
                    cap *= 2;
                    int* next = (int*)realloc(numbers, cap * sizeof(int));
                    if (!next) { 
                        free(numbers); 
                        return 1; 
                    }
                    numbers = next;
                }
                numbers[size++] = val;
            } else if (ret == EOF) {
                break;
            } else {
                int c = getchar();
                if (c == EOF) break;
            }
        }
    }

    size_t out_size = 0;
    int* odd_numbers = filter_odd_numbers(numbers, (size_t)size, &out_size);

    printf("[");
    for (size_t i = 0; i < out_size; ++i) {
        printf("%d%s", odd_numbers[i], i == out_size - 1 ? "" : ", ");
    }
    printf("]\n");

    if (odd_numbers != NULL) {
        free(odd_numbers);
    }
    free(numbers);

    return 0;
}
```