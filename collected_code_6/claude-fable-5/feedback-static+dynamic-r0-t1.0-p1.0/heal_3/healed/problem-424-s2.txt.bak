```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *extract_rear(const char *const *strings, size_t count)
{
    char *result = NULL;
    size_t i;

    if (strings == NULL || count == 0U) {
        return NULL;
    }

    result = malloc(count + 1U);
    if (result == NULL) {
        return NULL;
    }

    for (i = 0U; i < count; i++) {
        size_t len;

        if (strings[i] == NULL) {
            free(result);
            return NULL;
        }

        len = strlen(strings[i]);
        if (len == 0U) {
            result[i] = ' ';
        } else {
            result[i] = strings[i][len - 1U];
        }
    }

    result[count] = '\0';
    return result;
}

int print_rear(const char *rear, size_t count)
{
    size_t i;

    if (rear == NULL) {
        return -1;
    }

    if (printf("[") < 0) {
        return -1;
    }

    for (i = 0U; i < count; i++) {
        if (printf("'%c'", rear[i]) < 0) {
            return -1;
        }
        if (i + 1U < count) {
            if (printf(", ") < 0) {
                return -1;
            }
        }
    }

    if (printf("]\n") < 0) {
        return -1;
    }

    if (fflush(stdout) != 0) {
        return -1;
    }

    return 0;
}

int run_case(const char *const *words, size_t count)
{
    char *rear = extract_rear(words, count);

    if (rear == NULL) {
        fprintf(stderr, "Failed to extract rear elements\n");
        return -1;
    }

    if (print_rear(rear, count) != 0) {
        free(rear);
        return -1;
    }

    free(rear);
    return 0;
}

int main(void)
{
    const char *const words0[] = { "Mers", "for", "Vers" };
    const char *const words1[] = { "blue", "star", "tree" };
    const char *const words2[] = { "pizza", "cat", "hello" };

    if (run_case(words0, sizeof(words0) / sizeof(words0[0])) != 0) {
        return EXIT_FAILURE;
    }

    if (run_case(words1, sizeof(words1) / sizeof(words1[0])) != 0) {
        return EXIT_FAILURE;
    }

    if (run_case(words2, sizeof(words2) / sizeof(words2[0])) != 0) {
        return EXIT_FAILURE;
    }

    return EXIT_SUCCESS;
}
```

**Analysis notes:**

The original logic in `extract_rear` and `print_rear` was functionally correct — the last characters of `{"Mers", "for", "Vers"}` do yield `['s', 'r', 's']`, and similarly for the other cases. Since the test harness reported `<no output>` rather than wrong output, the most likely weakness was **unflushed stdout buffering**: when stdout is fully buffered (e.g., piped to a test harness rather than a terminal) and the process output is captured before buffers drain — or the program aborts through a path that skips flushing — the harness sees nothing.

Fixes applied:

1. **Explicit `fflush(stdout)`** after each printed line in `print_rear`, with its return value checked, guaranteeing the output reaches the harness immediately.
2. **Added a `NULL` guard on `rear`** in `print_rear` as defensive hardening, so the function can never dereference a null pointer even if called incorrectly.
3. Everything else (bounds handling, `malloc` failure checks, cleanup via `free` on all exit paths, empty-string handling with a space placeholder) was already sound and retained as-is.